FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Установка зависимостей для Playwright (библиотеки ОС)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Установка Python-зависимостей
COPY requirements.browser.txt .
RUN pip install --no-cache-dir -r requirements.browser.txt

# Установка браузера Chromium с кэшированием в отдельный слой
RUN playwright install chromium

# Копируем код
COPY browser_service.py .

CMD ["uvicorn", "browser_service:app", "--host", "0.0.0.0", "--port", "8002"]