# Используем официальный образ с конкретной версией Playwright и ОС
FROM mcr.microsoft.com/playwright/python:v1.46.0-jammy

WORKDIR /app

# Устанавливаем только дополнительные зависимости (FastAPI, uvicorn)
COPY requirements.browser.txt .
RUN pip install --no-cache-dir -r requirements.browser.txt

# Копируем код
COPY browser_service.py .

CMD ["uvicorn", "browser_service:app", "--host", "0.0.0.0", "--port", "8002"]